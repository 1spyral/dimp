{
  "name": "dimp-bot",
  "private": true,
  "scripts": {
    "dev": "bun run --watch --no-check src/app.ts",
    "start": "bun run --no-check src/app.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "bun test ./tests --preload ./tests/setup.ts --env-file ./env.test",
    "test:watch": "bun test ./tests --watch --preload ./tests/setup.ts --env-file ./env.test",
    "sync-commands": "bun run scripts/sync-commands.ts",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "type": "module",
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "discord.js": "^14.25.1",
    "graphql": "^16.13.1",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.6",
    "pino": "^10.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-graphql-request": "^7.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@types/node": "^25.2.0",
    "@types/pino": "^7.0.5",
    "bun-types": "^1.3.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "bun": ">=1.3.12"
  }
}
