{
  "name": "dimp-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch --no-check src/app.ts",
    "start": "bun run --no-check src/app.ts",
    "test": "bun run test:unit",
    "test:unit": "bun test ./tests/env.test.ts ./tests/logger.test.ts ./tests/ai ./tests/db ./tests/graphql --preload ./tests/setup.ts --env-file ./env.test",
    "test:unit:watch": "bun test ./tests/env.test.ts ./tests/logger.test.ts ./tests/ai ./tests/db ./tests/graphql --watch --preload ./tests/setup.ts --env-file ./env.test",
    "test:integration": "bun test ./tests/integration --preload ./tests/integration/setup.ts --env-file ./env.test --max-concurrency 1",
    "test:integration:watch": "bun test ./tests/integration --watch --preload ./tests/integration/setup.ts --env-file ./env.test --max-concurrency 1",
    "test:integration:db:up": "docker compose -f ./docker-compose.test.yml up -d --wait postgres-test",
    "test:integration:db:down": "docker compose -f ./docker-compose.test.yml down -v",
    "test:integration:db:migrate": "bun run --env-file ./env.test ./scripts/migrate-test-db.ts",
    "test:integration:local": "bun run ./scripts/test-integration-local.ts",
    "test:watch": "bun test --watch --preload ./tests/setup.ts --env-file ./env.test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir ./coverage --preload ./tests/setup.ts --env-file ./env.test",
    "test:coverage:watch": "bun test --watch --coverage --coverage-reporter=text --coverage-dir ./coverage --preload ./tests/setup.ts --env-file ./env.test",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "generate-schema": "bun run scripts/generate-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@elysiajs/graphql-yoga": "^1.4.0",
    "@langchain/anthropic": "^1.3.13",
    "@langchain/core": "^1.1.17",
    "@langchain/langgraph": "^1.1.2",
    "@langchain/openai": "^1.2.4",
    "@pothos/core": "^4.12.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.25",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "langchain": "^1.2.16",
    "pino": "^10.3.0",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.0",
    "@types/pino": "^7.0.5",
    "bun-types": "^1.3.8",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
