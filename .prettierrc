{
    "arrowParens": "avoid",
    "tabWidth": 4,
    "plugins": ["prettier-plugin-organize-imports"],
    "overrides": [
        {
            "files": ["*.yaml", "*.yml"],
            "options": {
                "tabWidth": 2
            }
        }
    ],
    "semi": false,
    "singleQuote": false,
    "trailingComma": "es5"
}
